{
  "name": "mailkib",
  "productName": "MailKib",
  "version": "0.2.5",
  "description": "A fast, keyboard-first mail client. Tokyo Night and friends.",
  "main": "./out/main/index.js",
  "author": "kib",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "npm run build && electron-builder --linux AppImage",
    "dist:all": "npm run build && electron-builder --linux AppImage pacman deb",
    "dist:dir": "npm run build && electron-builder --linux dir"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "dompurify": "^3.2.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "marked": "^18.0.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "desktopName": "mailkib.desktop"
}
